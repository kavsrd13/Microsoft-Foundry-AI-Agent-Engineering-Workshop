# Foundry Project Endpoint and Storage Queue Configuration
# Format: https://<resource-name>.services.ai.azure.com/api/projects/<project-name>
PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project

# Azure Storage Queue Service Endpoint
# Format: https://<storage-account-name>.queue.core.windows.net
STORAGE_QUEUE_ENDPOINT=https://your-storage-account.queue.core.windows.net

# Chat Model Deployment Name
MODEL_DEPLOYMENT=gpt-4o-mini
