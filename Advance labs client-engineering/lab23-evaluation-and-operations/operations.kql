// Application Insights Logs schema; for a workspace use AppDependencies/AppRequests and corresponding columns.
union dependencies, requests
| where timestamp > ago(24h) and name == 'rag-answer'
| extend input_tokens = tolong(customDimensions['gen_ai.usage.input_tokens']),
         output_tokens = tolong(customDimensions['gen_ai.usage.output_tokens'])
| summarize calls=count(), failed=countif(success == false), p95_ms=percentile(duration,95),
            input_tokens=sum(input_tokens), output_tokens=sum(output_tokens) by bin(timestamp,1h)

// Run separately: follow one operation across spans, errors and traces.
// union dependencies, requests, exceptions, traces
// | where operation_Id == 'PASTE-TRACE-ID'
// | order by timestamp asc
